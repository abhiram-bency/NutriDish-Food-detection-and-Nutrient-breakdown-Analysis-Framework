.huggingface/

# Add any other temporary or generated files here

# Model artifacts (trained models are versioned)
# Remove the following line if you want to use Git LFS for large models
# *.keras
# *.h5

# Note: If you have very large model files (e.g., >100MB each) and want to use Git LFS,
# uncomment the following lines and install git-lfs:
# *.keras filter=lfs diff=lfs merge=lfs -text
# *.h5 filter=lfs diff=lfs merge=lfs -text
# *.hdf5 filter=lfs diff=lfs merge=lfs -text

# Test data (sample images for CLI testing)
test_images/
test_images/*
*Zone.Identifier

# Backup directories
NutriDish_backup_*/
*/backup_*/